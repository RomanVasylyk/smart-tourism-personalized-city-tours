POSTGIS_IMAGE=postgis/postgis:16-3.4
OSRM_IMAGE=osrm/osrm-backend:v5.27.1
OSRM_DATA_FILE=slovakia-latest.osrm

POSTGRES_DB=smart_tourism
POSTGRES_USER=smart_tourism
POSTGRES_PASSWORD=smart_tourism
POSTGRES_PORT=5432

DATABASE_URL=postgresql://smart_tourism:smart_tourism@db:5432/smart_tourism
BACKEND_PORT=8000

ROUTING_ENABLED=true
ROUTING_BASE_URL=http://routing:5000
ROUTING_PROFILE=foot
ROUTING_TIMEOUT_SECONDS=0.75
ROUTING_TABLE_ENABLED=true
ROUTING_PORT=5000

FEEDBACK_RECOMPUTE_INTERVAL_SECONDS=3600
FEEDBACK_RECOMPUTE_CITY=
FEEDBACK_RECOMPUTE_RUN_ON_START=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_ROUTE_GENERATE=30/minute
RATE_LIMIT_ROUTE_LEG=60/minute
